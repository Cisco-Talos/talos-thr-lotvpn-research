---
extends: default

rules:
  line-length:
    max: 120
    level: warning  # Don't fail on long lines (URLs)

  indentation:
    spaces: 2
    indent-sequences: consistent

  document-start: disable  # No --- requirement

  truthy:
    allowed-values: ['true', 'false', 'yes', 'no']
    check-keys: false

  empty-values:
    forbid-in-block-mappings: false

ignore: |
  site/
  .venv/
  __pycache__/
